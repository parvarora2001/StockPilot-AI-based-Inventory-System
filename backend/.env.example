# Copy this file to .env and fill in your values.
# The app runs in demo mode (template-based alerts) when GOOGLE_API_KEY is absent.

# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here

# Optional — defaults to gemini-2.0-flash if unset
GEMINI_MODEL=gemini-2.0-flash

# Set this to your deployed frontend URL so CORS works in production
# e.g. https://stockpilot.vercel.app
FRONTEND_URL=
